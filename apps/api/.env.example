PORT=8787
DB_PATH=./data/gatepass.db

# mainnet | testnet
NIMIQ_NETWORK=mainnet

# Mainnet default: https://rpc.nimiqwatch.com
# Testnet: set this to your test-albatross history node RPC URL
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Wait for this many confirmations before issuing a ticket
NIMIQ_MIN_CONFIRMATIONS=1

# Max time to poll for the payment tx (ms)
NIMIQ_TX_WAIT_MS=45000

# Allow demo:true purchases (no chain). Keep false for real Pay flows.
SKIP_TX_VERIFY=false
